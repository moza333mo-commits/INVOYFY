@page
<!-- File: Pages/Error.cshtml -->
@model ErrorModel
@{
    ViewData["Title"] = "خطأ في النظام";
}

<div class="text-center py-5">
    <h1 class="text-danger fw-bold">حدث خطأ غير متوقع.</h1>
    <h2 class="text-muted h5 mt-2">عذراً، تعذر إتمام معالجة الطلب في الوقت الحالي.</h2>

    @if (Model.ShowRequestId)
    {
        <p class="mt-3">
            <strong>معرّف الطلب (Request ID):</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-success px-4">العودة إلى الصفحة الرئيسية</a>
    </div>
</div>